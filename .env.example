# SQLite connection string used for local development. For production on PostgreSQL, replace
# with a postgresql:// URL (see "Migrating to PostgreSQL" in README.md) and switch the Prisma
# datasource provider + driver adapter accordingly.
DATABASE_URL="file:./dev.db"

# Session/JWT signing secret for Auth.js. Generate a fresh one for every environment:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"

# Signed Netlify form-notification webhook used by the CRM checklist integration.
# Configure the same random value as the JWS secret in Netlify's outgoing form webhook.
NETLIFY_WEBHOOK_SECRET="replace-with-a-separate-random-secret"

# Optional road-routing server used by the quotation calculator. The public OSRM endpoint is used
# when omitted; set this to a managed/private OSRM-compatible service for guaranteed production SLA.
# ROUTING_BASE_URL="https://router.project-osrm.org"

# Optional for the current single-organisation installation. Set this to the Organisation.id
# before adding more organisations so incoming website leads always reach the correct CRM.
# NETLIFY_CRM_ORGANISATION_ID="organisation-cuid"

# Seed account created by `npm run db:seed` (local/demo use only — change or remove for production).
SEED_ORG_NAME="MALTAMAN"
SEED_USER_NAME="Ján Technik"
SEED_USER_EMAIL="technik@maltaman.sk"
SEED_USER_PASSWORD="maltaman123"

# Private photo/logo storage. Two backends (see src/lib/storage.ts), selected automatically:
#
#  • Tigris (S3-compatible object storage), used in production. Set the four vars below and
#    the app stores uploads there. On Fly.io, `fly ext tigris create` provisions a bucket and
#    injects these as secrets, so you don't set them by hand there.
#  • Local filesystem (this STORAGE_DIR), used for development when the Tigris vars are unset.
#    Files live outside `public/` and are only served via the authenticated
#    /api/photos/[photoId]/file route.
STORAGE_DIR="./storage"

# Uncomment to use Tigris/S3 object storage locally instead of the filesystem:
# BUCKET_NAME="your-bucket-name"
# AWS_ACCESS_KEY_ID="tid_..."
# AWS_SECRET_ACCESS_KEY="tsec_..."
# AWS_ENDPOINT_URL_S3="https://fly.storage.tigris.dev"
# AWS_REGION="auto"
